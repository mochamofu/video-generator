# GPU設定 (true=GPU使用, false=CPU使用)
USE_GPU=false

# LLMプロバイダー設定
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o

# 動画素材APIキー (Pexels または Pixabay どちらか一方が必要)
# https://www.pexels.com/api/ で無料取得
PEXELS_API_KEYS=your-pexels-api-key-here

# https://pixabay.com/api/docs/ で無料取得
PIXABAY_API_KEYS=
