# GPU設定 (true=GPU使用, false=CPU使用)
USE_GPU=false

# LLMプロバイダー設定
# openai / ollama / gemini から選択
LLM_PROVIDER=ollama

# Ollama設定（LLM_PROVIDER=ollamaの場合）
# Ollamaをインストール後、使いたいモデル名を入力
# おすすめ: llama3.2, gemma3, qwen2.5
OLLAMA_MODEL_NAME=llama3.2

# OpenAI設定（LLM_PROVIDER=openaiの場合のみ必要）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o

# 動画素材APIキー (Pexels または Pixabay どちらか一方が必要・無料)
# https://www.pexels.com/api/ で無料取得
PEXELS_API_KEYS=your-pexels-api-key-here

# https://pixabay.com/api/docs/ で無料取得
PIXABAY_API_KEYS=
